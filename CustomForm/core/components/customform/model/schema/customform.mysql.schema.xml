<?xml version="1.0" encoding="UTF-8"?>
<model package="customform" baseClass="xPDO\Om\xPDOObject" platform="mysql" defaultEngine="InnoDB" version="3.0">
    <object class="CustomFormSubmission" table="customform_submissions" extends="xPDO\Om\xPDOSimpleObject">
        <field key="name"       dbtype="varchar" precision="100" phptype="string" null="false"/>
        <field key="phone"      dbtype="varchar" precision="20"  phptype="string" null="false"/>
        <field key="email"      dbtype="varchar" precision="150" phptype="string" null="true"/>
        <field key="message"    dbtype="text"                    phptype="string" null="true"/>
        <field key="crm_id"     dbtype="varchar" precision="50"  phptype="string" null="true"/>
        <field key="status"     dbtype="varchar" precision="20"  phptype="string" default="new"/>
        <field key="createdon"  dbtype="datetime"                phptype="datetime" null="true"/>

        <index alias="phone" name="phone" primary="false" unique="false">
            <column key="phone" length="" collation="A" null="false"/>
        </index>
    </object>
</model>